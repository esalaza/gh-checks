#!/usr/bin/env node
// gh checks: a terminal dashboard of open pull requests with every CI check
// expanded, refreshed on a timer. No dependencies beyond Node and gh.
'use strict';

const { execFile } = require('node:child_process');

const HELP = `Usage: gh checks [-R owner/repo | --all] [-i seconds] [--show-passed] [--no-mouse]
                 [--light | --dark]

A live dashboard of your open pull requests with every CI check shown.
Re-runs supersede earlier attempts, so a running re-run shows as running
rather than as the old failure. Piped output prints the list once.

  -R, --repo REPO       only PRs in this repo (default: the repo of the current
                        folder, when it is one)
      --all             PRs from every repo, even inside a repo folder
  -i, --interval SECS   refresh every SECS seconds (default 30, minimum 5)
      --show-passed     start with passed and skipped checks shown (hidden by
                        default; p toggles them)
      --no-mouse        leave the mouse to the terminal (normal text selection)
      --list, --table   checks as one list per PR, ordered by status (the
                        default), or as a table with a column per workflow
      --light, --dark   light colours on paper white (the default), or dark
                        colours on charcoal; t switches between them as it runs
      --bg COLOUR       background while the dashboard runs, as #rrggbb, or
                        "none" to keep the terminal's; b tries others as it runs
  -h, --help            show this help

Keys:
  ↑ ↓ ← →  or k j h l   move between PRs and checks
  tab, shift-tab        next / previous PR (wrapping round at the ends)
  g, G                  first / last PR
  o, enter              open the selected PR or check log in the browser
  y                     copy the selected PR's number (#123) to the clipboard
  Y                     copy the selected PR's URL
  b                     try the next background colour (keep one with --bg)
  t                     switch between dark and light colours
  v                     switch between the list and table layouts
  s                     sort by status (failing first, the default) or by most
                        recently updated
  R                     re-run failed jobs (selected check, or the whole PR)
  r                     refresh now
  p                     hide / show passed and skipped checks
  1 2 3                 Assigned / Mine / Review requested
  q, ctrl-c             quit

Mouse:
  click                 select a PR or check; click it again to open it
  wheel                 scroll
  click a tab           switch section
  click a PR's #number  copy it (#123) to the clipboard
  right-click a PR      copy its number
  Hold Option (macOS terminals) or Shift (most others) to select text.

Symbols: ✗ failed  ● running  ○ queued (yellow)  ⊘ cancelled  ✓ passed  ○ skipped (grey)
`;

const opts = { repo: '', all: false, interval: 30, hidePassed: true, mouse: true, theme: '', demo: false, bg: '', layout: 'list' };
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '-R' || a === '--repo') opts.repo = argv[++i] || '';
  else if (a === '-i' || a === '--interval') opts.interval = Math.max(5, Number(argv[++i]) || 30);
  else if (a === '--show-passed') opts.hidePassed = false;
  else if (a === '--hide-passed') opts.hidePassed = true;
  else if (a === '--no-mouse') opts.mouse = false;
  else if (a === '--all') opts.all = true;
  else if (a === '--bg') opts.bg = argv[++i] || '';
  else if (a === '--table' || a === '--list') opts.layout = a.slice(2);
  else if (a === '--demo') opts.demo = true; // made-up data from demo.json, for screenshots
  else if (a === '--light' || a === '--dark') opts.theme = a.slice(2);
  else if (a === '-h' || a === '--help') {
    process.stdout.write(HELP);
    process.exit(0);
  } else {
    process.stderr.write(`gh checks: unknown argument: ${a}\n\n${HELP}`);
    process.exit(1);
  }
}

const SECTIONS = [
  { title: 'Assigned', qualifiers: 'assignee:@me' },
  { title: 'Mine', qualifiers: 'author:@me' },
  { title: 'Review requested', qualifiers: 'review-requested:@me' },
];

const QUERY = `
query($q: String!) {
  search(query: $q, type: ISSUE, first: 50) {
    issueCount
    nodes {
      ... on PullRequest {
        number title url isDraft baseRefName
        autoMergeRequest { mergeMethod }
        mergeStateStatus reviewDecision
        latestReviews(first: 20) { nodes { state author { login } } }
        reviewRequests(first: 10) { nodes { requestedReviewer { ... on User { login } ... on Team { name } ... on Bot { login } } } }
        reviewThreads(first: 100) { nodes { isResolved } }
        stack { size entries(first: 30) { nodes { position pullRequest { number state } } } }
        stackEntry { position }
        repository { name nameWithOwner }
        commits(last: 1) { nodes { commit { statusCheckRollup { contexts(first: 100) { nodes {
          __typename
          ... on CheckRun {
            name status conclusion detailsUrl startedAt completedAt
            checkSuite { workflowRun { databaseId event workflow { name } } }
          }
          ... on StatusContext { context state targetUrl createdAt }
        } } } } } }
      }
    }
  }
}`;

// ---------------------------------------------------------------- data

function gh(args) {
  return new Promise((resolve, reject) => {
    execFile('gh', args, { maxBuffer: 32 * 1024 * 1024 }, (err, stdout, stderr) => {
      if (err) reject(new Error((stderr || err.message).trim().split('\n')[0]));
      else resolve(stdout);
    });
  });
}

const RANK = { fail: 0, run: 1, queue: 2, cancel: 3, pass: 4, skip: 5 };
const FAILED = new Set(['FAILURE', 'TIMED_OUT', 'STARTUP_FAILURE', 'ACTION_REQUIRED']);

function category(ctx) {
  if (ctx.__typename === 'CheckRun') {
    if (ctx.status === 'COMPLETED') {
      if (ctx.conclusion === 'SUCCESS') return 'pass';
      if (FAILED.has(ctx.conclusion)) return 'fail';
      if (ctx.conclusion === 'CANCELLED') return 'cancel';
      return 'skip';
    }
    return ctx.status === 'IN_PROGRESS' ? 'run' : 'queue';
  }
  return { SUCCESS: 'pass', FAILURE: 'fail', ERROR: 'fail', PENDING: 'run' }[ctx.state] || 'queue';
}

// Short names for the events that start workflow runs, to tell apart one
// job run for several events.
const EVENTS = {
  push: 'push', pull_request: 'PR', pull_request_target: 'PR target', merge_group: 'merge queue',
  workflow_dispatch: 'manual', schedule: 'scheduled', workflow_run: 'chained', issue_comment: 'comment',
  pull_request_review: 'review', pull_request_review_comment: 'review comment', repository_dispatch: 'dispatch',
};
// A pull request's checks usually run for a push or the pull request itself;
// any other event (a review, a comment, a manual run) is named on the check.
const USUAL_EVENTS = new Set(['push', 'pull_request']);

function toPr(node) {
  const contexts = node.commits.nodes[0]?.commit.statusCheckRollup?.contexts.nodes ?? [];
  // A re-run adds a new check run beside the old one; keep only the latest
  // attempt. Runs of one workflow started by different events (a push and a
  // pull request, say) are separate checks, as GitHub counts them.
  const latest = new Map();
  for (const ctx of contexts) {
    const run = ctx.checkSuite?.workflowRun;
    const check =
      ctx.__typename === 'CheckRun'
        ? { wf: run?.workflow?.name ?? '', event: run?.event ?? '', runId: run?.databaseId ?? null, name: ctx.name,
            url: ctx.detailsUrl ?? '', t: ctx.startedAt ?? '9999', cat: category(ctx),
            started: ctx.startedAt ?? null, completed: ctx.completedAt ?? null }
        : { wf: '', event: '', runId: null, name: ctx.context, url: ctx.targetUrl ?? '',
            t: ctx.createdAt ?? '', cat: category(ctx) };
    const key = `${check.wf}\u0000${check.name}\u0000${check.event}`;
    const prev = latest.get(key);
    if (!prev || check.t >= prev.t) latest.set(key, check);
  }
  const checks = [...latest.values()];
  // Each check is drawn under its workflow's heading, so its own name is enough,
  // unless the workflow ran it for more than one event, or for an unusual one.
  const uses = {};
  for (const c of checks) uses[`${c.wf}\u0000${c.name}`] = (uses[`${c.wf}\u0000${c.name}`] || 0) + 1;
  for (const c of checks) {
    const tagged = c.event && (uses[`${c.wf}\u0000${c.name}`] > 1 || !USUAL_EVENTS.has(c.event));
    c.tag = tagged ? ` (${EVENTS[c.event] ?? c.event})` : '';
    c.label = c.name + c.tag;
  }
  return settle({ number: node.number, title: node.title, url: node.url, draft: node.isDraft, base: node.baseRefName,
                  autoMerge: node.autoMergeRequest?.mergeMethod ?? null,
                  mergeState: node.mergeStateStatus ?? null, reviewDecision: node.reviewDecision ?? null,
                  reviews: (node.latestReviews?.nodes ?? []).map((r) => ({ state: r.state, by: r.author?.login ?? '?' })),
                  waitingOn: (node.reviewRequests?.nodes ?? []).map((r) => r.requestedReviewer?.login ?? r.requestedReviewer?.name)
                    .filter(Boolean),
                  unresolved: (node.reviewThreads?.nodes ?? []).filter((t) => !t.isResolved).length,
                  stack: stackOf(node),
                  repo: node.repository.nameWithOwner, repoName: node.repository.name, checks });
}

// Where a pull request sits in one of GitHub's stacks: its position (1 on the
// base branch), the stack's size, and the open pull requests below it,
// nearest first.
function stackOf(node) {
  const position = node.stackEntry?.position;
  if (!position || !node.stack) return null;
  const below = (node.stack.entries?.nodes ?? [])
    .filter((e) => e.position < position && e.pullRequest?.state === 'OPEN')
    .sort((a, b) => b.position - a.position)
    .map((e) => e.pullRequest.number);
  return { position, size: node.stack.size, below };
}

// Orders a PR's checks (failed first) and counts them by status.
function settle(pr) {
  pr.checks.sort((a, b) => RANK[a.cat] - RANK[b.cat] || a.label.localeCompare(b.label));
  pr.counts = {};
  for (const c of pr.checks) pr.counts[c.cat] = (pr.counts[c.cat] || 0) + 1;
  return pr;
}

// The checks a branch requires before merging, from its rulesets and any
// classic branch protection, kept for ten minutes as they rarely change.
const requiredCache = new Map();
async function requiredChecks(repo, branch) {
  const key = `${repo}:${branch}`;
  const hit = requiredCache.get(key);
  if (hit && Date.now() - hit.at < 600000) return hit.names;
  const names = new Set();
  const ref = encodeURIComponent(branch);
  try {
    for (const rule of JSON.parse(await gh(['api', `repos/${repo}/rules/branches/${ref}`]))) {
      if (rule.type === 'required_status_checks') {
        for (const c of rule.parameters?.required_status_checks ?? []) names.add(c.context);
      }
    }
  } catch {
    // No rules, or no access to them.
  }
  try {
    const classic = JSON.parse(await gh(['api', `repos/${repo}/branches/${ref}/protection/required_status_checks`]));
    for (const c of classic.contexts ?? []) names.add(c);
  } catch {
    // Not protected.
  }
  requiredCache.set(key, { at: Date.now(), names });
  return names;
}

// GitHub lists a required check as "Expected" until its job reports, which can
// be a while when the workflow is waiting for a runner. Shows those as queued,
// in the workflow column the check appears under on other PRs, if any.
// Notes which checks the target branch requires, so the optional ones can be
// drawn fainter. A branch that requires none leaves every check as it is.
function markRequired(pr, required) {
  pr.hasRequired = required.size > 0;
  for (const c of pr.checks) c.required = required.has(c.name);
}

async function addExpectedChecks(prs) {
  const workflowOf = new Map();
  for (const pr of prs) for (const c of pr.checks) if (c.wf) workflowOf.set(c.name, c.wf);
  await Promise.all(prs.map(async (pr) => {
    if (!pr.base) return;
    const required = await requiredChecks(pr.repo, pr.base);
    markRequired(pr, required);
    const reported = new Set(pr.checks.map((c) => c.name));
    const missing = [...required].filter((name) => !reported.has(name));
    if (!missing.length) return;
    for (const name of missing) {
      pr.checks.push({ wf: workflowOf.get(name) ?? '', event: '', tag: ' (expected)', runId: null, name,
                       label: `${name} (expected)`, url: `${pr.url}/checks`, t: '', cat: 'queue', required: true });
    }
    settle(pr);
  }));
  return prs;
}

// Without -R or --all, scope to the current folder's repo, as gh itself would.
async function detectRepo() {
  if (opts.demo) opts.repo = demoData().repo;
  if (opts.repo || opts.all) return;
  try {
    opts.repo = (await gh(['repo', 'view', '--json', 'nameWithOwner', '-q', '.nameWithOwner'])).trim();
  } catch {
    // Not in a GitHub repo: list every repo.
  }
}

// --demo reads demo.json, which spells checks as [workflow, name, status, event]
// (workflow "" for app checks, event pull_request when left out) and a stack as
// its pull request numbers from the base up, and turns them into the API's shape.
let demo;
function demoData() {
  demo ??= JSON.parse(require('node:fs').readFileSync(require('node:path').join(__dirname, 'demo.json'), 'utf8'));
  return demo;
}

function demoNode(pr, repo) {
  const run = { pass: ['COMPLETED', 'SUCCESS'], fail: ['COMPLETED', 'FAILURE'], cancel: ['COMPLETED', 'CANCELLED'],
                skip: ['COMPLETED', 'SKIPPED'], run: ['IN_PROGRESS', null], queue: ['QUEUED', null] };
  const app = { pass: 'SUCCESS', fail: 'FAILURE', run: 'PENDING', queue: 'EXPECTED' };
  const url = `https://github.com/${repo}/pull/${pr.number}`;
  const runIds = [...new Set(pr.checks.map(([wf]) => wf))]; // one run per workflow, as on GitHub
  const minutesAgo = (m) => new Date(Date.now() - m * 60000).toISOString();
  const contexts = pr.checks.map(([wf, name, status, event = 'pull_request'], k) => wf
    ? { __typename: 'CheckRun', name, status: run[status][0], conclusion: run[status][1], detailsUrl: `${url}/checks`,
        startedAt: minutesAgo(4 + ((k * 7) % 19)),
        completedAt: run[status][0] === 'COMPLETED' ? minutesAgo(1 + ((k * 3) % 4)) : null, checkSuite: { workflowRun: { databaseId: runIds.indexOf(wf) + 1, event, workflow: { name: wf } } } }
    : { __typename: 'StatusContext', context: name, state: app[status], targetUrl: url });
  return { number: pr.number, title: pr.title, url, isDraft: !!pr.draft,
           autoMergeRequest: pr.autoMerge ? { mergeMethod: pr.autoMerge } : null,
           mergeStateStatus: pr.mergeState ?? 'BLOCKED', reviewDecision: pr.reviewDecision ?? 'REVIEW_REQUIRED',
           latestReviews: { nodes: (pr.reviews ?? []).map(([state, login]) => ({ state, author: { login } })) },
           reviewRequests: { nodes: (pr.waitingOn ?? []).map((login) => ({ requestedReviewer: { login } })) },
           reviewThreads: { nodes: Array.from({ length: pr.unresolved ?? 0 }, () => ({ isResolved: false })) },
           stack: pr.stack ? { size: pr.stack.length, entries: { nodes: pr.stack.map((number, k) =>
             ({ position: k + 1, pullRequest: { number, state: 'OPEN' } })) } } : null,
           stackEntry: pr.stack ? { position: pr.stack.indexOf(pr.number) + 1 } : null,
           repository: { name: repo.split('/')[1], nameWithOwner: repo },
           commits: { nodes: [{ commit: { statusCheckRollup: { contexts: { nodes: contexts } } } }] } };
}

async function fetchPrs(section) {
  if (opts.demo) {
    const { repo, sections } = demoData();
    const prs = sections[SECTIONS.indexOf(section)].map((pr) => toPr(demoNode(pr, repo)));
    for (const pr of prs) markRequired(pr, new Set(demoData().required ?? []));
    return { total: prs.length, prs };
  }
  const q = `is:pr is:open archived:false sort:updated-desc ${section.qualifiers}` +
    (opts.repo ? ` repo:${opts.repo}` : '');
  const { data } = JSON.parse(await gh(['api', 'graphql', '-f', `q=${q}`, '-f', `query=${QUERY}`]));
  const prs = data.search.nodes.filter((n) => n.number).map(toPr);
  return { total: data.search.issueCount, prs: await addExpectedChecks(prs) };
}

// ---------------------------------------------------------------- drawing

const tty = process.stdout.isTTY && process.stdin.isTTY;
const color = process.stdout.isTTY && !process.env.NO_COLOR;
const sgr = (code, s) => (color ? `\x1b[${code}m${s}\x1b[0m` : s);
// Paints a background behind already-coloured text, re-applying it after
// each inner reset so the whole run stays highlighted.
const highlight = (s) =>
  color ? `\x1b[${T.selBg}m${s.replaceAll('\x1b[0m', `\x1b[0m\x1b[${T.selBg}m`)}\x1b[0m` : s;
const width = (s) => [...s].length;
const fit = (s, w) => (width(s) > w ? [...s].slice(0, Math.max(0, w - 1)).join('') + '…' : s);
const pad = (s, w) => s + ' '.repeat(Math.max(0, w - width(s)));

// 256-colour palettes (every macOS terminal supports them), tuned for a dark
// or a light background.
const THEMES = {
  dark: {
    fail: '1;38;5;203', run: '1;38;5;214', queue: '38;5;221', cancel: '38;5;248',
    pass: '1;38;5;84', skip: '38;5;247',
    number: '1;38;5;68', repo: '38;5;68', prTitle: '1;38;5;231', draftTitle: '38;5;245', title: '38;5;255', dim: '38;5;248', rule: '38;5;239', divider: '38;5;238',
    brand: '1;38;5;213', tabOn: '1;38;5;255;48;5;239', tabOff: '38;5;248',
    selBg: '48;5;237', key: '1;38;5;75', confirm: '1;38;5;221', colHead: '1;38;5;250', bg: '#1c1c21',
  },
  light: {
    fail: '1;38;5;160', run: '1;38;5;166', queue: '1;38;5;130', cancel: '1;38;5;240',
    pass: '1;38;5;28', skip: '1;38;5;243',
    number: '1;38;5;25', repo: '38;5;25', prTitle: '1;38;5;232', draftTitle: '38;5;244', title: '38;5;235', dim: '38;5;242', rule: '38;5;250', divider: '38;5;253',
    brand: '1;38;5;127', tabOn: '1;38;5;235;48;5;252', tabOff: '38;5;242',
    selBg: '48;5;254', key: '1;38;5;25', confirm: '1;38;5;136', colHead: '1;38;5;240', bg: '#f7f7f5',
  },
};
// COLORFGBG ("15;0") ends with the background colour where the terminal sets it.
const bgColour = Number((process.env.COLORFGBG || '').split(';').pop());
// The dashboard defaults to light colours on its own paper background. Piped
// output can't set a background, so it follows the terminal's where known.
let themeName = opts.theme || (tty || bgColour === 7 || bgColour === 15 ? 'light' : 'dark');
let T = THEMES[themeName]; // swapped live by the t key

const SYM = { fail: '✗', run: '●', queue: '○', cancel: '⊘', pass: '✓', skip: '○' };
const sym = (cat) => sgr(T[cat], SYM[cat]);

let hidePassed = opts.hidePassed;
const visibleChecks = (pr) => (hidePassed ? pr.checks.filter((c) => RANK[c.cat] < RANK.pass) : pr.checks);

function summary(counts) {
  const parts = Object.keys(RANK).filter((k) => counts[k]);
  if (!parts.length) return { text: sgr(T.dim, 'no checks'), w: 9 };
  return {
    text: parts.map((k) => sgr(T[k], `${SYM[k]} ${counts[k]}`)).join('  '),
    w: parts.reduce((w, k) => w + 2 + String(counts[k]).length, 0) + 2 * (parts.length - 1),
  };
}

const OTHER = 'Other checks'; // checks posted by apps rather than by a workflow
const GAP = 3; // spaces between table columns

// The table's columns: every workflow on any listed PR, the busiest first so
// the order holds between refreshes, and checks from other apps last.
// The layout of the checks beside each PR: 'list' (one column, ordered by
// status, each check followed by its workflow) or 'table' (a column per
// workflow). Switched by the v key.
let layout = opts.layout;
const LIST = 'Checks';
let listLabelW = 0; // the list's widest check name, so workflow names line up
let listTimeW = 0; // and its widest timing, so the workflow names line up

// Whole minutes: "<1m", "3m", "1h 5m". A time still running is marked
// approximate ("~3m"), as it moves on between refreshes.
function duration(ms, running = false) {
  const m = Math.floor(Math.max(0, ms) / 60000);
  if (m < 1) return '<1m';
  const text = m < 60 ? `${m}m` : `${Math.floor(m / 60)}h ${m % 60}m`;
  return running ? `~${text}` : text;
}

// A check's timing, as GitHub words it: "started 3m ago", "failed after 3m".
function timing(c) {
  if (!c.started) return '';
  const start = Date.parse(c.started);
  const end = c.completed ? Date.parse(c.completed) : Date.now();
  switch (c.cat) {
    case 'run': return `started ${duration(Date.now() - start, true)} ago`;
    case 'queue': return `waiting ${duration(Date.now() - start, true)}`;
    case 'pass': return c.completed ? `took ${duration(end - start)}` : '';
    case 'fail': return c.completed ? `failed after ${duration(end - start)}` : '';
    case 'cancel': return c.completed ? `cancelled after ${duration(end - start)}` : '';
    default: return '';
  }
}

function tableColumns(prs) {
  if (layout === 'list') return [LIST];
  const totals = new Map();
  for (const pr of prs) {
    for (const c of pr.checks) totals.set(c.wf || OTHER, (totals.get(c.wf || OTHER) || 0) + 1);
  }
  return [...totals.keys()].sort((a, b) =>
    (a === OTHER) - (b === OTHER) || totals.get(b) - totals.get(a) || a.localeCompare(b));
}

// One PR's cell under one workflow column: the checks it shows, each with its
// index in visibleChecks(pr) (which is how the selection names a check), and
// a count of the passed and skipped ones it hides.
function cellOf(pr, name) {
  const shown = visibleChecks(pr);
  const mine = name === LIST ? pr.checks : pr.checks.filter((c) => (c.wf || OTHER) === name);
  const items = shown.map((c, index) => ({ c, index })).filter(({ c }) => mine.includes(c));
  const counts = ['pass', 'skip']
    .map((k) => [k, mine.filter((c) => c.cat === k && !shown.includes(c)).length])
    .filter(([, n]) => n);
  return {
    items,
    note: counts.map(([k, n]) => sgr(T[k], `${SYM[k]} ${n}`)).join('  '),
    noteW: counts.reduce((w, [, n]) => w + 2 + String(n).length, 0) + 2 * Math.max(0, counts.length - 1),
  };
}

// Sizes each column to its widest heading or cell line, shrinks the widest
// while the table overflows, and shares any spare width out evenly.
function columnWidths(prs, names, labels, cols) {
  const widths = names.map((name, j) => Math.max(width(labels[j]), ...prs.map((pr) => {
    const { items, noteW } = cellOf(pr, name);
    return Math.max(noteW, ...items.map(({ c }) =>
      (layout === 'list' ? 2 + listLabelW + 3 + listTimeW + 3 + width(c.wf) : 2 + width(c.label))));
  })));
  const avail = cols - 2 - GAP * Math.max(0, names.length - 1);
  let total = widths.reduce((a, b) => a + b, 0);
  while (total > avail) {
    const i = widths.indexOf(Math.max(...widths));
    if (widths[i] <= 8) break;
    widths[i]--;
    total--;
  }
  const spare = Math.max(0, avail - total);
  return widths.map((w) => w + Math.floor(spare / names.length));
}

// Joins [x, text, visible width] pieces into one line. Padding is counted
// from the visible widths, as the escape codes in `text` would throw it off.
function row(pieces) {
  let line = '';
  let at = 0;
  for (const [x, text, w] of pieces) {
    line += ' '.repeat(Math.max(0, x - at)) + text;
    at = Math.max(at, x) + w;
  }
  return line;
}

// Where a PR stands for merging and review, as coloured pieces:
// "conflicts", "behind main", "ready to merge", "changes requested by ana",
// "approved by luke", "waiting on ana, luke", "3 unresolved". "Blocked" goes
// unsaid, as the checks and review state already explain it.
function prStatus(pr) {
  const out = [];
  const merge = {
    DIRTY: ['conflicts', T.fail], BEHIND: [`behind ${pr.base || 'base'}`, T.queue],
    CLEAN: ['ready to merge', T.pass], HAS_HOOKS: ['ready to merge', T.pass], UNSTABLE: ['ready to merge', T.pass],
  }[pr.mergeState];
  if (merge && !pr.draft) out.push(merge);
  const by = (state) => [...new Set(pr.reviews.filter((r) => r.state === state).map((r) => r.by))].join(', ');
  if (pr.reviewDecision === 'CHANGES_REQUESTED' || by('CHANGES_REQUESTED')) {
    out.push([`changes requested${by('CHANGES_REQUESTED') ? ` by ${by('CHANGES_REQUESTED')}` : ''}`, T.fail]);
  } else if (by('APPROVED')) {
    out.push([`approved by ${by('APPROVED')}`, T.pass]);
  } else if (pr.reviewDecision === 'REVIEW_REQUIRED' && !pr.waitingOn.length && !pr.draft) {
    out.push(['review required', T.queue]);
  }
  if (pr.waitingOn.length) out.push([`waiting on ${pr.waitingOn.join(', ')}`, T.queue]);
  if (pr.unresolved) out.push([`${pr.unresolved} unresolved`, T.queue]);
  return out;
}

// Packs coloured [text, tone] pieces into lines of at most `w` columns, two
// spaces apart, as [line, visible width] pairs.
function packStatus(pieces, w) {
  const lines = [];
  for (const [raw, tone] of pieces) {
    const text = fit(raw, w);
    const last = lines[lines.length - 1];
    if (last && last[1] + 2 + width(text) <= w) {
      last[0] += `  ${sgr(tone, text)}`;
      last[1] += 2 + width(text);
    } else {
      lines.push([sgr(tone, text), width(text)]);
    }
  }
  return lines;
}

// One icon for the whole PR: red ✗ when a check failed or was cancelled,
// orange ● while any is running, queued or expected, green ✓ when all passed
// or were skipped, grey ○ with no checks. Where the target branch requires
// checks, only those can turn it red; optional failures stay in the list.
function overall(pr) {
  if (!pr.checks.length) return [SYM.skip, T.skip];
  const counts = pr.hasRequired ? pr.checks.filter((c) => c.required) : pr.checks;
  if (counts.some((c) => c.cat === 'fail' || c.cat === 'cancel')) return [SYM.fail, T.fail];
  if (pr.checks.some((c) => c.cat === 'run' || c.cat === 'queue')) return [SYM.run, T.run];
  return [SYM.pass, T.pass];
}

// Word-wraps `text` to `w` columns, in at most `max` lines.
function wrap(text, w, max) {
  const out = [];
  for (const word of text.split(/\s+/)) {
    const last = out[out.length - 1];
    if (last !== undefined && width(last) + 1 + width(word) <= w) out[out.length - 1] = `${last} ${word}`;
    else out.push(word);
  }
  if (out.length > max) out.splice(max - 1, out.length, out.slice(max - 1).join(' '));
  return out.map((line) => fit(line, w));
}

// Lays out the PRs as a table, one row per PR: the PR itself (number,
// wrapped title, check counts) in the first column, then a column per
// workflow. The heading row is returned apart, to be drawn once above the
// list. `sel` is the selected { pr, check } (check -1 = the PR itself), or
// null when printing, and `copied` names a PR ("owner/repo#123") whose number
// was just copied. `hits` holds, per line, the ranges a mouse click can land
// on, and `cells` each PR's check positions, for moving the cursor.
function buildLines(prs, cols, sel, copied = null) {
  const multi = new Set(prs.map((p) => p.repo)).size > 1;
  // The list layout has room to spare beside its one column of checks, so its
  // PR column is wider and titles wrap less.
  const prW = layout === 'list'
    ? Math.max(36, Math.min(64, Math.round(cols * 0.36)))
    : Math.max(30, Math.min(50, Math.round(cols * 0.28)));
  const restCols = cols - prW - GAP;
  const names = tableColumns(prs);
  listLabelW = Math.min(40, Math.max(0, ...prs.flatMap((pr) => visibleChecks(pr).map((c) => width(c.label)))));
  listTimeW = Math.min(24, Math.max(0, ...prs.flatMap((pr) => visibleChecks(pr).map((c) => width(timing(c))))));
  // Headings drop a "pr: "-style prefix when the full names don't fit across.
  let labels = names;
  let widths = columnWidths(prs, names, labels, restCols);
  if (widths.some((w, j) => w < width(names[j]))) {
    labels = names.map((name) => name.replace(/^[^:]+: /, ''));
    widths = columnWidths(prs, names, labels, restCols);
  }
  const xs = [];
  widths.reduce((x, w) => (xs.push(x), x + w + GAP), 2 + prW + GAP);
  const heading = row([[2, sgr(T.colHead, 'Pull request'), 12], ...labels.map((label, j) => {
    const text = fit(label, widths[j]);
    return [xs[j], sgr(T.colHead, text), width(text)];
  })]);

  const lines = [];
  const hits = [];
  const blocks = [];
  const cells = [];
  let cursor = 0;
  prs.forEach((pr, i) => {
    const start = lines.length;
    const selectedPr = sel && sel.pr === i && sel.check < 0;
    if (selectedPr) cursor = start;

    // The PR cell: the number, then the wrapped title led by a summary icon,
    // then the counts, then "draft", "auto-merge" and "stack" where they apply
    // (squash, the usual method, goes unsaid).
    const prefix = `${multi ? pr.repoName + ' ' : ''}#${pr.number}`;
    const [icon, iconTone] = overall(pr);
    const indent = width(prefix) + 2;
    const titleLines = wrap(pr.title, prW - indent - 2, 3);
    const tags = [
      pr.draft && ['draft', T.dim],
      pr.autoMerge && [pr.autoMerge === 'SQUASH' ? 'auto-merge' : `auto-merge (${pr.autoMerge.toLowerCase()})`, T.key],
      pr.stack && [`stack ${pr.stack.position}/${pr.stack.size}`, T.dim],
    ].filter(Boolean);
    const sum = summary(pr.counts);
    // A draft's title is grey and not bold, so the pull requests ready for
    // review stand out.
    const titleTone = pr.draft ? T.draftTitle : T.prTitle;
    // Just copied: the number turns green, with "copied" beneath it where the
    // gutter is wide enough.
    const justCopied = copied === `${pr.repo}#${pr.number}`;
    const number = sgr(justCopied ? T.pass : T.number, prefix);
    // A stacked PR lists the open PRs below it under its number, nearest
    // first, as far as four; "↓ #12" squeezes to "↓#12" in a narrow gutter.
    const below = pr.stack?.below ?? [];
    const arrows = (below.length > 4 ? [...below.slice(0, 3).map((n) => `#${n}`), `+${below.length - 3}`] : below.map((n) => `#${n}`))
      .map((n) => [`↓ ${n}`, `↓${n}`].find((a) => width(a) <= indent + 1))
      .map((a) => a && [sgr(T.dim, '↓') + sgr(T.repo, a.slice(1)), width(a)]);
    const gutter = (k) => {
      if (justCopied && k === 1 && indent >= 7) return sgr(T.pass, 'copied') + ' '.repeat(indent - 6);
      const [text, w] = arrows[k - 1] ?? ['', 0];
      return text + ' '.repeat(Math.max(0, indent - w));
    };
    const statusLines = packStatus(prStatus(pr), prW - indent - 2);
    const prCell = [
      ...titleLines.map((t, k) => [
        k === 0 ? `${number}  ${sgr(iconTone, icon)} ${sgr(titleTone, t)}` : `${gutter(k)}  ${sgr(titleTone, t)}`,
        indent + 2 + width(t),
      ]),
      // The counts and status line up with the title's text, past its icon.
      [`${gutter(titleLines.length)}  ${sum.text}${tags.map(([text, tone]) => `  ${sgr(tone, text)}`).join('')}`,
        indent + 2 + sum.w + tags.reduce((w, [text]) => w + 2 + width(text), 0)],
      ...statusLines.map(([text, w], k) => [`${gutter(titleLines.length + 1 + k)}  ${text}`, indent + 2 + w]),
    ];
    // More PRs below than the cell has lines: give the rest lines of their own.
    while (prCell.length <= arrows.length) prCell.push([gutter(prCell.length), indent]);

    cells[i] = [];
    const prCells = names.map((name) => cellOf(pr, name));
    const height = Math.max(prCell.length, ...prCells.map((pc) => pc.items.length + (pc.note ? 1 : 0)));
    for (let r = 0; r < height; r++) {
      const at = lines.length;
      hits[at] = [{ pr: i, check: -1, x0: 0, x1: 2 + prW }];
      if (r === 0) hits[at].unshift({ pr: i, check: -1, x0: 2, x1: 2 + width(prefix), copy: true });
      const [prText, prTextW] = prCell[r] || ['', 0];
      const prPiece = selectedPr
        ? [2, highlight(prText + ' '.repeat(Math.max(0, prW - prTextW))), prW]
        : [2, prText, prTextW];
      lines.push(row([prPiece, ...prCells.map((pc, j) => {
        const item = pc.items[r];
        if (!item) return r === pc.items.length && pc.note ? [xs[j], pc.note, pc.noteW] : [xs[j], '', 0];
        // Shorten the job name rather than the event tag that tells duplicates apart.
        const nameW = layout === 'list' ? Math.min(listLabelW, widths[j] - 2) : widths[j] - 2;
        const label = fit(item.c.name, nameW - width(item.c.tag)) + item.c.tag;
        let after = '';
        let afterW = 0;
        if (layout === 'list') {
          // Name, then timing, then workflow, each lined up.
          const room = widths[j] - 2 - nameW - 3;
          const timeW = Math.min(listTimeW, room);
          const time = timeW >= 6 ? fit(timing(item.c), timeW) : '';
          const wf = room - timeW - 3 >= 4 ? fit(item.c.wf, room - timeW - 3) : '';
          if (time || wf) {
            after = ' '.repeat(nameW - width(label) + 3) + sgr(T.dim, time);
            afterW = nameW - width(label) + 3 + width(time);
          }
          if (wf) {
            after += ' '.repeat(timeW - width(time) + 3) + sgr(T.dim, wf);
            afterW += timeW - width(time) + 3 + width(wf);
          }
        }
        cells[i].push({ check: item.index, line: at, x: xs[j], band: 0 });
        hits[at].push({ pr: i, check: item.index, x0: xs[j], x1: xs[j] + widths[j] });
        if (sel && sel.pr === i && sel.check === item.index) {
          cursor = at;
          return [xs[j], highlight(`${sym(item.c.cat)} ${sgr(`1;${T.title}`, label)}`) + after, 2 + width(label) + afterW];
        }
        const optional = prs[i].hasRequired && !item.c.required;
        const tone = RANK[item.c.cat] >= RANK.cancel || optional ? T.dim : T.title;
        return [xs[j], `${sym(item.c.cat)} ${sgr(tone, label)}${after}`, 2 + width(label) + afterW];
      })]));
    }
    blocks.push([start, lines.length]);
    if (i < prs.length - 1) lines.push(sgr(T.divider, '─'.repeat(cols)));
  });
  return { lines, hits, blocks, cells, cursor, heading };
}

// ---------------------------------------------------------------- one-shot output

if (!tty) {
  detectRepo().then(() => fetchPrs(SECTIONS[0])).then(
    ({ total, prs }) => {
      const { lines, heading } = buildLines(prs, process.stdout.columns || Number(process.env.COLUMNS) || 160, null);
      if (prs.length) lines.unshift(heading, '');
      if (!prs.length) lines.push('No open pull requests.');
      else if (total > prs.length) lines.push(`Showing ${prs.length} of ${total} pull requests.`);
      process.stdout.write(lines.join('\n') + '\n');
    },
    (err) => {
      process.stderr.write(`gh checks: ${err.message}\n`);
      process.exit(1);
    },
  );
  return;
}

// ---------------------------------------------------------------- dashboard

const state = {
  section: 0,
  data: SECTIONS.map(() => null), // { total, prs }
  attempted: SECTIONS.map(() => 0), // when each section was last fetched
  loading: new Set(),
  error: null,
  pr: 0,
  check: -1,
  scroll: 0,
  follow: true, // keep the cursor on screen; off after the wheel scrolls away
  cells: [], // per PR, where each check sits: { check, line, x, band }
  hits: [], // click targets per body line, from buildLines
  tabHits: [], // [x0, x1) of each section tab in the top bar
  confirm: null, // { text, action }
  flash: null, // { text, code, until }
  copied: null, // { key: 'owner/repo#123', until }: the number just copied by a click
};

// PRs are shown by their summary icon: failing, then running, then green,
// then those with no checks, keeping GitHub's most-recently-updated order
// within each. The s key switches to that update order alone.
let sortBy = 'status';
const STATUS_ORDER = { [SYM.fail]: 0, [SYM.run]: 1, [SYM.pass]: 2, [SYM.skip]: 3 };
function ordered(list) {
  if (sortBy !== 'status') return list;
  return list.map((pr, n) => [STATUS_ORDER[overall(pr)[0]] ?? 3, n, pr]).sort((a, b) => a[0] - b[0] || a[1] - b[1]).map(([, , pr]) => pr);
}
const prs = () => ordered(state.data[state.section]?.prs ?? []);

function flash(text, code = T.pass) {
  state.flash = { text, code, until: Date.now() + 5000 };
}

function clampSelection() {
  const list = prs();
  state.pr = Math.min(Math.max(0, state.pr), Math.max(0, list.length - 1));
  const n = list.length ? visibleChecks(list[state.pr]).length : 0;
  state.check = Math.min(state.check, n - 1);
}

async function refresh(section = state.section) {
  if (state.loading.has(section)) return;
  state.loading.add(section);
  state.attempted[section] = Date.now();
  render();
  try {
    const data = await fetchPrs(SECTIONS[section]);
    // Keep the cursor on the same PR and check, wherever they moved to.
    const before = state.section === section ? prs()[state.pr] : null;
    const label = before && state.check >= 0 ? visibleChecks(before)[state.check]?.label : null;
    state.data[section] = data;
    if (before && state.section === section) {
      const i = prs().findIndex((p) => p.number === before.number && p.repo === before.repo);
      if (i >= 0) {
        state.pr = i;
        state.check = label ? visibleChecks(prs()[i]).findIndex((c) => c.label === label) : -1;
      }
    }
    state.error = null;
  } catch (err) {
    state.error = err.message;
  }
  state.loading.delete(section);
  clampSelection();
  render();
}

// The first cell by `order`, or undefined.
const first = (cells, order) => [...cells].sort(order)[0];

// Moves the cursor through the workflow columns as they are drawn: up and
// down stay in a column, then cross to the band above or below, then to the
// neighbouring PR; left and right step to the next column at the nearest row.
function move(dir) {
  const list = prs();
  if (!list.length) return;
  const cells = state.cells[state.pr] || [];
  const cur = cells.find((c) => c.check === state.check);
  const topLeft = (a, b) => a.line - b.line || a.x - b.x;
  const toPr = (i, fromBottom = false) => {
    if (i < 0 || i >= list.length) return;
    state.pr = i;
    const target = fromBottom && first(state.cells[i] || [], (a, b) => b.line - a.line || a.x - b.x);
    state.check = target ? target.check : -1;
  };
  let next;
  if (!cur) {
    if (dir === 'up') return toPr(state.pr - 1, true);
    if (dir === 'down' && !cells.length) return toPr(state.pr + 1);
    if (dir === 'down' || dir === 'right') next = first(cells, topLeft);
  } else if (dir === 'down' || dir === 'up') {
    const sign = dir === 'down' ? 1 : -1;
    const sameColumn = cells.filter((c) => c.x === cur.x && c.band === cur.band && sign * (c.line - cur.line) > 0);
    const otherBand = cells.filter((c) => sign * (c.band - cur.band) > 0);
    next =
      first(sameColumn, (a, b) => sign * (a.line - b.line)) ||
      first(otherBand, (a, b) => sign * (a.band - b.band) ||
        Math.abs(a.x - cur.x) - Math.abs(b.x - cur.x) || sign * (a.line - b.line));
    if (!next) return dir === 'down' ? toPr(state.pr + 1) : void (state.check = -1);
  } else {
    const sign = dir === 'right' ? 1 : -1;
    const beside = cells.filter((c) => c.band === cur.band && sign * (c.x - cur.x) > 0);
    next = first(beside, (a, b) => sign * (a.x - b.x) || Math.abs(a.line - cur.line) - Math.abs(b.line - cur.line));
  }
  if (next) state.check = next.check;
}

function selected() {
  const pr = prs()[state.pr];
  if (!pr) return {};
  return { pr, check: state.check >= 0 ? visibleChecks(pr)[state.check] : null };
}

// Copies with the system tool where there is one, else asks the terminal to
// (OSC 52, which iTerm2, Ghostty, kitty and VS Code understand).
function copy(text) {
  const tools = process.platform === 'darwin'
    ? [['pbcopy', []]]
    : [['wl-copy', []], ['xclip', ['-selection', 'clipboard']], ['xsel', ['--clipboard', '--input']]];
  const attempt = ([tool, ...rest]) => {
    if (!tool) {
      process.stdout.write(`\x1b]52;c;${Buffer.from(text).toString('base64')}\x07`);
      return;
    }
    const child = require('node:child_process').spawn(tool[0], tool[1], { stdio: ['pipe', 'ignore', 'ignore'] });
    child.on('error', () => attempt(rest));
    child.stdin.on('error', () => {});
    child.stdin.end(text);
  };
  attempt(tools);
  flash(`Copied ${text}`);
}

function copyPr(what) {
  const { pr } = selected();
  if (pr) copy(what === 'url' ? pr.url : `#${pr.number}`);
}

function openUrl(url) {
  if (!url) return;
  const cmd = process.platform === 'darwin' ? 'open' : 'xdg-open';
  execFile(cmd, [url], (err) => err && flash(`Could not open ${url}`, T.fail));
}

function askRerun() {
  const { pr, check } = selected();
  if (!pr) return;
  const targets = (check ? [check] : pr.checks).filter((c) => c.cat === 'fail' || c.cat === 'cancel');
  const runIds = [...new Set(targets.map((c) => c.runId).filter(Boolean))];
  if (!runIds.length) {
    flash(check ? 'This check has nothing to re-run.' : `#${pr.number} has no failed workflow jobs.`, T.run);
    return;
  }
  const what = check ? `"${check.label}"` : `#${pr.number}`;
  state.confirm = {
    text: `Re-run failed jobs for ${what} (${runIds.length} workflow run${runIds.length > 1 ? 's' : ''})? y/n`,
    action: async () => {
      flash(`Re-running failed jobs for ${what}…`, T.run);
      render();
      try {
        if (!opts.demo) for (const id of runIds) await gh(['run', 'rerun', String(id), '--failed', '-R', pr.repo]);
        flash(`Re-run started for ${what}.`);
        setTimeout(() => refresh(), 3000);
      } catch (err) {
        flash(err.message, T.fail);
      }
      render();
    },
  };
}

function render() {
  if (state.confirm?.help) return;
  const cols = process.stdout.columns || 100;
  const rows = process.stdout.rows || 30;
  const bodyH = Math.max(1, rows - 5); // top bar, rule, column headings, rule, footer
  const list = prs();
  const data = state.data[state.section];

  const tabs = SECTIONS.map((s, i) =>
    sgr(i === state.section ? T.tabOn : T.tabOff, ` ${i + 1} ${s.title} `)).join(' ');
  let status;
  if (state.loading.has(state.section)) status = sgr(T.run, '⟳ refreshing');
  else if (state.error) status = sgr(T.fail, fit(`! ${state.error}`, Math.max(10, cols - 60)));
  else {
    const left = Math.max(0, Math.ceil((state.attempted[state.section] + opts.interval * 1000 - Date.now()) / 1000));
    const at = new Date(state.attempted[state.section]).toLocaleTimeString(undefined, { hour12: false });
    status = sgr(T.dim, `updated ${at} · next ${left}s`);
  }
  const scope = sgr(T.repo, opts.repo || 'all repos');
  const header = `${sgr(T.brand, ' gh checks')}  ${tabs}   ${scope}   ${status}`;
  let x = width(' gh checks  ');
  state.tabHits = SECTIONS.map((s) => {
    const range = [x, x + width(s.title) + 4];
    x = range[1] + 1;
    return range;
  });

  let body;
  let heading = '';
  state.hits = [];
  if (!data) body = [sgr(T.dim, state.error ? '' : ' Loading…')];
  else if (!list.length) body = [sgr(T.dim, ' No open pull requests.')];
  else {
    const built = buildLines(list, cols, { pr: state.pr, check: state.check },
      state.copied?.until > Date.now() ? state.copied.key : null);
    state.cells = built.cells;
    heading = built.heading;
    state.hits = built.hits;
    body = built.lines;
    if (data.total > list.length) body.push(sgr(T.dim, `Showing ${list.length} of ${data.total} pull requests.`));
    // Keep the cursor on screen, and show a whole PR when its header is selected.
    const [start, end] = built.blocks[state.pr];
    if (state.follow) {
      if (built.cursor < state.scroll) state.scroll = built.cursor;
      if (built.cursor >= state.scroll + bodyH) state.scroll = built.cursor - bodyH + 1;
      if (state.check < 0 && end - start <= bodyH && end > state.scroll + bodyH) state.scroll = end - bodyH;
    }
    state.scroll = Math.max(0, Math.min(state.scroll, body.length - bodyH));
    // Say how many PRs start above or below the screen, at the end of the
    // column headings, so none are missed off the bottom.
    const above = built.blocks.filter(([first]) => first < state.scroll).length;
    const below = built.blocks.filter(([first]) => first >= state.scroll + bodyH).length;
    const more = [above && `↑ ${above} above`, below && `↓ ${below} below`].filter(Boolean).join('  ');
    if (more) {
      const used = width(heading.replace(/\x1b\[[0-9;]*m/g, ''));
      heading += ' '.repeat(Math.max(2, cols - used - width(more) - 1)) + sgr(T.key, more);
    }
  }
  const visible = body.slice(state.scroll, state.scroll + bodyH);
  while (visible.length < bodyH) visible.push('');

  let footer;
  if (state.confirm) footer = sgr(T.confirm, ` ${state.confirm.text}`);
  else if (state.flash && state.flash.until > Date.now()) footer = sgr(state.flash.code, ` ${state.flash.text}`);
  else {
    // As many "key action" pairs as fit, keys bright and actions dim.
    const keys = [['↑↓←→', 'move'], ['tab', 'next PR'], ['o', selected().check ? (selected().check.runId ? 'open job log' : 'open check') : 'open PR'], ['click #', 'copy'], ['v', layout === 'list' ? 'table' : 'list'], ['s', sortBy === 'status' ? 'by update' : 'by status'], ['R', 're-run failed'], ['r', 'refresh'],
      ['p', `${hidePassed ? 'show' : 'hide'} passed`], ['1-3', 'section'], ['?', 'help'], ['q', 'quit']];
    let used = 1;
    footer = ' ';
    for (const [k, action] of keys) {
      const w = width(k) + 1 + width(action) + 2;
      if (used + w > cols) break;
      footer += `${sgr(T.key, k)} ${sgr(T.dim, action)}  `;
      used += w;
    }
  }

  const frame = [header, sgr(T.rule, '─'.repeat(cols)), heading, sgr(T.divider, '─'.repeat(cols)), ...visible, footer];
  process.stdout.write('\x1b[H' + frame.map((l) => l + '\x1b[K').join('\n'));
}

function showHelp() {
  process.stdout.write('\x1b[H\x1b[2J' + HELP.slice(HELP.indexOf('Keys:')).replace(/\n/g, '\r\n') +
    '\r\n  Press any key to return.');
  state.confirm = { text: '', action: null, help: true };
}

function switchSection(i) {
  if (i === state.section) return;
  Object.assign(state, { section: i, pr: 0, check: -1, scroll: 0, follow: true, error: null });
  if (!state.data[i] || Date.now() - state.attempted[i] >= opts.interval * 1000) refresh(i);
}

function onKey(key) {
  if (key === 'C-c') return quit();
  if (state.confirm) {
    const { action } = state.confirm;
    state.confirm = null;
    if (action && key === 'y') action();
    return render();
  }
  const list = prs();
  state.follow = true;
  switch (key) {
    case 'q': return quit();
    case 'up': case 'k': move('up'); break;
    case 'down': case 'j': move('down'); break;
    case 'left': case 'h': move('left'); break;
    case 'right': case 'l': move('right'); break;
    // tab and shift-tab wrap round from the last PR to the first, and back.
    case 'tab': if (list.length) { state.pr = (state.pr + 1) % list.length; state.check = -1; } break;
    case 'S-tab': if (list.length) { state.pr = (state.pr - 1 + list.length) % list.length; state.check = -1; } break;
    case 'g': state.pr = 0; state.check = -1; state.scroll = 0; break;
    case 'G': state.pr = Math.max(0, list.length - 1); state.check = -1; break;
    case 'return': case 'o': {
      const { pr, check } = selected();
      openUrl(check ? check.url : pr?.url);
      break;
    }
    case 'r': refresh(); break;
    case 'R': askRerun(); break;
    case 'y': copyPr('number'); break;
    case 'Y': copyPr('url'); break;
    case 'b': nextBackground(); break;
    case 't': toggleTheme(); break;
    case 'v': layout = layout === 'list' ? 'table' : 'list'; state.check = -1; break;
    case 's': {
      // Keep the same PR selected in its new place.
      const { pr } = selected();
      sortBy = sortBy === 'status' ? 'updated' : 'status';
      if (pr) state.pr = Math.max(0, prs().indexOf(pr));
      state.check = -1;
      flash(sortBy === 'status' ? 'Sorted by status: failing first' : 'Sorted by most recently updated', T.key);
      break;
    }
    case 'p': {
      const { check } = selected();
      hidePassed = !hidePassed;
      state.check = check && list[state.pr] ? visibleChecks(list[state.pr]).indexOf(check) : -1;
      break;
    }
    case '1': case '2': case '3': switchSection(Number(key) - 1); break;
    case '?': return showHelp();
  }
  render();
}

// x and y are 1-based screen positions, as the terminal reports them.
function onMouse(button, x, y) {
  if (state.confirm) return onKey('');
  if (button === 64 || button === 65) {
    state.scroll += button === 64 ? -3 : 3; // render clamps it
    state.follow = false;
    return render();
  }
  if (button === 2) {
    const hit = state.hits[y - 5 + state.scroll]?.find((h) => x - 1 >= h.x0 && x - 1 < h.x1);
    if (!hit) return;
    Object.assign(state, { pr: hit.pr, check: -1, follow: true });
    copyPr('number');
    return render();
  }
  if (button !== 0) return;
  if (y === 1) {
    const tab = state.tabHits.findIndex(([x0, x1]) => x - 1 >= x0 && x - 1 < x1);
    if (tab >= 0) switchSection(tab);
    return render();
  }
  const hit = state.hits[y - 5 + state.scroll]?.find((h) => x - 1 >= h.x0 && x - 1 < h.x1);
  if (!hit) return;
  if (hit.copy) {
    const pr = prs()[hit.pr];
    Object.assign(state, { pr: hit.pr, check: -1, follow: true });
    copy(`#${pr.number}`);
    state.copied = { key: `${pr.repo}#${pr.number}`, until: Date.now() + 1200 };
    setTimeout(render, 1300);
    return render();
  }
  if (hit.pr === state.pr && hit.check === state.check) return onKey('o');
  Object.assign(state, { pr: hit.pr, check: hit.check, follow: true });
  render();
}

const KEYS = {
  '\x1b[A': 'up', '\x1b[B': 'down', '\x1b[C': 'right', '\x1b[D': 'left',
  '\x1bOA': 'up', '\x1bOB': 'down', '\x1bOC': 'right', '\x1bOD': 'left',
  '\x1b[Z': 'S-tab', '\t': 'tab', '\r': 'return', '\n': 'return', '\x03': 'C-c',
};

// Splits raw input into mouse reports (SGR mode), named keys and characters.
function onInput(buf) {
  let s = buf.toString('utf8');
  while (s) {
    const mouse = /^\x1b\[<(\d+);(\d+);(\d+)([Mm])/.exec(s);
    const seq = !mouse && Object.keys(KEYS).find((k) => s.startsWith(k));
    let used;
    if (mouse) {
      if (mouse[4] === 'M') onMouse(Number(mouse[1]), Number(mouse[2]), Number(mouse[3]));
      used = mouse[0].length;
    } else if (seq) {
      onKey(KEYS[seq]);
      used = seq.length;
    } else if (s[0] === '\x1b') {
      used = /^\x1b(?:\[[0-9;?<]*[~A-Za-z]|O.)?/.exec(s)[0].length; // other sequences: ignore
    } else {
      const ch = [...s][0];
      onKey(ch);
      used = ch.length;
    }
    s = s.slice(used);
  }
}

const MOUSE_ON = opts.mouse ? '\x1b[?1000h\x1b[?1006h' : '';
// The window background while the dashboard runs (OSC 11), put back to the
// terminal's own on exit (OSC 111). Terminals without OSC 11 ignore both.
const bg = opts.bg === 'none' ? '' : (opts.bg || T.bg).replace(/^(?=[0-9a-f]{6}$)/i, '#');
if (bg && !/^#[0-9a-f]{6}$/i.test(bg)) {
  process.stderr.write(`gh checks: --bg wants #rrggbb or none, not "${opts.bg}"\n`);
  process.exit(1);
}
const BG_ON = bg ? `\x1b]11;${bg}\x07` : '';

// Backgrounds to try with b, darkest first, ending with the terminal's own.
// Backgrounds to try with b, for each set of colours, ending with the terminal's own.
const BACKGROUNDS = {
  dark: [
    ['#1c1c21', 'charcoal'], ['#212126', 'graphite'], ['#25262b', 'slate'], ['#282c34', 'one dark'],
    ['#2b2d31', 'ash'], ['#2e3440', 'nord'], ['#303236', 'pewter'], ['#34363c', 'smoke'], ['', 'your terminal\'s'],
  ],
  light: [
    ['#f7f7f5', 'paper'], ['#fdf6e3', 'solarized'], ['#ffffff', 'white'], ['#f2f2ef', 'stone'],
    ['#eff1f5', 'latte'], ['#f4f1ea', 'linen'], ['#e9ebee', 'mist'], ['', 'your terminal\'s'],
  ],
};
let bgIndex = Math.max(0, BACKGROUNDS[themeName].findIndex(([hex]) => hex === bg));

function setBackground(hex) {
  process.stdout.write(hex ? `\x1b]11;${hex}\x07` : '\x1b]111\x07');
}

function nextBackground() {
  const list = BACKGROUNDS[themeName];
  bgIndex = (bgIndex + 1) % list.length;
  const [hex, name] = list[bgIndex];
  setBackground(hex);
  const theme = themeName === 'light' ? ' --light' : '';
  flash(`Background ${bgIndex + 1}/${list.length}: ${name}` +
    (hex ? ` ${hex}. To keep it: gh checks${theme} --bg '${hex}'` : `. To keep it: gh checks${theme} --bg none`), T.key);
}

// Swaps between the dark and light colours, each on its own default background.
function toggleTheme() {
  themeName = themeName === 'dark' ? 'light' : 'dark';
  T = THEMES[themeName];
  bgIndex = 0;
  setBackground(BACKGROUNDS[themeName][0][0]);
  flash(`${themeName === 'light' ? 'Light' : 'Dark'} colours. To keep them: gh checks --${themeName}`, T.key);
}
const RESTORE = (opts.mouse ? '\x1b[?1000l\x1b[?1006l' : '') + '\x1b]111\x07' +
  '\x1b[?7h\x1b[?25h\x1b[?1049l';

function quit() {
  process.stdout.write(RESTORE);
  process.exit(0);
}

process.on('exit', () => process.stdout.write(RESTORE));
process.on('SIGTERM', quit);

// Alternate screen, hidden cursor, no line wrap, mouse reporting.
process.stdout.write('\x1b[?1049h\x1b[?25l\x1b[?7l' + MOUSE_ON + BG_ON);
process.stdin.setRawMode(true);
process.stdin.on('data', onInput);
process.stdout.on('resize', render);

render();
detectRepo().then(() => {
  // Ticks every second for the countdown, and refreshes the open section when due.
  setInterval(() => {
    if (Date.now() - state.attempted[state.section] >= opts.interval * 1000) refresh();
    else if (!state.confirm?.help) render();
  }, 1000);
  refresh();
});
